{
  "name": "alpaka-desktop",
  "version": "1.3.1",
  "description": "Native Linux desktop client for Ollama",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src --ext .ts,.vue --fix",
    "lint:check": "eslint src --ext .ts,.vue",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "e2e:build": "pnpm tauri build --features test-mode --config src-tauri/tauri.test.conf.json",
    "e2e:smoke": "NODE_OPTIONS='--import tsx' wdio run e2e-desktop/wdio.smoke.conf.ts",
    "e2e:integration": "NODE_OPTIONS='--import tsx' wdio run e2e-desktop/wdio.integration.conf.ts",
    "e2e:all": "pnpm e2e:smoke && pnpm e2e:integration",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "@types/katex": "^0.16.0",
    "@types/markdown-it": "^14.1.0",
    "@vueuse/core": "^14.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "katex": "^0.16.47",
    "markdown-it": "^14.3.2",
    "markdown-it-footnote": "^4.0.0",
    "pinia": "^3.0.4",
    "shiki": "^4.1.0",
    "vue": "^3.5.43",
    "vue-router": "^4.4.0",
    "vue-virtual-scroller": "^3.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "~2.11.5",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@wdio/cli": "^9",
    "@wdio/local-runner": "^9",
    "@wdio/mocha-framework": "^9",
    "@wdio/spec-reporter": "^9",
    "@wdio/types": "^9",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^27.4.0",
    "mermaid": "^11.16.1",
    "prettier": "^3.9.9",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5.6.0",
    "vite": "^8.3.2",
    "vitepress": "^1.6.0",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "webdriverio": "^9"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "minimatch@<3.1.2": "3.1.5",
      "serialize-javascript@<7.0.0": "7.0.5",
      "tar-fs@<3.1.2": "3.1.2",
      "ws@<8.17.1": "8.17.1",
      "fast-xml-parser@<5.7.0": "5.7.0",
      "tmp@<=0.2.3": "0.2.4",
      "uuid@<14.0.0": "^14.0.0",
      "js-cookie@<3.0.7": "^3.0.7",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12"
    }
  }
}
